
# connection string:
#   mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/
#   PREFIX = mongodb+srv://      URL = @cluster0.xxxxx.mongodb.net/
MONGODB_PREFIX="mongodb+srv://"
MONGODB_USERNAME="db_username"
MONGODB_PASSWORD="db_password"
MONGODB_URL="@cluster0.xxxxx.mongodb.net/"
MONGODB_DBNAME="AfterSchool"
